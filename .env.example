PORT=3000
APP_BASE_URL=http://localhost:3000

# URL da sua API que envia mensagens para o Instagram.
# O servidor fara POST para esta URL quando um fluxo precisar responder.
OUTBOUND_API_URL=https://sua-api.com/messages
OUTBOUND_API_TOKEN=cole-seu-token-aqui

# Opcional: segredo para proteger o webhook.
# Se preencher, envie o header x-webhook-secret com o mesmo valor.
WEBHOOK_SECRET=

# Token que voce cria para a verificacao do webhook na Meta.
META_VERIFY_TOKEN=crie-um-token-simples-aqui
